{
  "name": "freekamerbot",
  "version": "1.0.0",
  "description": "Monitor Kamernet, Funda, and Pararius listings with automatic replies and notifications",
  "main": "server/index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "dev": "npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": [
    "kamernet",
    "funda",
    "pararius",
    "housing",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "body-parser": "^1.20.4",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "lowdb": "^1.0.0",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.15.0",
    "web-push": "^3.6.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
