# Server Configuration
PORT=3001
NODE_ENV=development

# Kamernet Credentials (required for auto-reply)
KAMERNET_EMAIL=your-email@example.com
KAMERNET_PASSWORD=your-password

# Notification Settings
ENABLE_NOTIFICATIONS=true
ENABLE_MOBILE_NOTIFICATIONS=false

# Monitoring Intervals (in minutes)
KAMERNET_INTERVAL=5
FUNDA_INTERVAL=10
PARARIUS_INTERVAL=10
MESSAGES_INTERVAL=5

# Auto-reply Settings
AUTO_REPLY_ENABLED=false
AUTO_REPLY_MESSAGE="Hi, I'm interested in this property. Could we schedule a viewing? Best regards"

# Puppeteer / Browser automation
# If install skipped Chromium download, set path to your Chrome/Chromium here (optional)
# Examples:
#  - /usr/bin/google-chrome
#  - /usr/bin/chromium-browser
#  - /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=
# Set to false to see the browser UI for debugging
AUTO_REPLY_HEADLESS=true

# Optional: Override default search URLs (leave blank to use defaults)
KAMERNET_SEARCH_URL=
FUNDA_SEARCH_URL=
PARARIUS_SEARCH_URL=

# Extra agency/source URLs can be configured from the app UI (Settings > Extra Listing Sources)
